<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in – {{AppName}}</title>
  <style>
    :root {
      --ink: #12141c;
      --panel: #171a25;
      --bar: #0f1118;
      --line: #262a3a;
      --active: #1d2130;
      --text: #d9d5c9;
      --dim: #69708a;
      --amber: #ffb347;
      --sky: #8fb4ff;
      --sage: #a3d9a5;
      --err: #ff7b72;
      color-scheme: dark;
    }

    * { box-sizing: border-box; }

    html, body { margin: 0; }

    body {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px 14px;
      background: var(--ink);
      color: var(--text);
      font: 15px/1.9 ui-monospace, "SF Mono", "Cascadia Code", "JetBrains Mono", Menlo, Consolas, monospace;
    }

    .editor {
      width: min(660px, 100%);
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    }

    .tabs {
      display: flex;
      justify-content: space-between;
      align-items: stretch;
      background: var(--bar);
      border-bottom: 1px solid var(--line);
      font-size: 13px;
      line-height: 1;
    }

    .tab {
      padding: 13px 18px;
      background: var(--panel);
      border-bottom: 2px solid var(--amber);
      margin-bottom: -1px;
    }

    .host {
      padding: 13px 18px;
      color: var(--dim);
    }

    .code { padding: 14px 0 18px; }

    .ln {
      display: grid;
      grid-template-columns: 52px 1fr;
      min-height: 1.9em;
      box-shadow: inset 2px 0 0 transparent;
    }

    .ln > b {
      font-weight: 400;
      color: var(--dim);
      text-align: right;
      padding-right: 18px;
      user-select: none;
    }

    .ln > div {
      padding-right: 20px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0 1.2ch;
      min-width: 0;
    }

    .ln:focus-within {
      background: var(--active);
      box-shadow: inset 2px 0 0 var(--amber);
    }

    .ln:focus-within > b { color: var(--amber); }

    .comment { color: var(--sky); }

    .err > div,
    .err > b { color: var(--err); }

    .key { color: var(--text); }
    .op { color: var(--dim); }

    .cursor {
      display: inline-block;
      width: 0.6em;
      height: 1.2em;
      margin-left: 1px;
      background: var(--amber);
      vertical-align: text-bottom;
      animation: blink 1.06s steps(1) infinite;
    }

    .cursor.off { display: none; }

    @keyframes blink {
      50% { opacity: 0; }
    }

    .field input[type="text"],
    .field input[type="password"] {
      flex: 1;
      min-width: 0;
      border: 0;
      outline: 0;
      padding: 0;
      background: transparent;
      color: var(--sage);
      font: inherit;
      caret-color: var(--amber);
      caret-shape: block;
    }

    .field input:-webkit-autofill {
      -webkit-text-fill-color: var(--sage);
      transition: background-color 99999s;
    }

    .remember {
      display: inline-flex;
      align-items: center;
      gap: 1ch;
      color: var(--dim);
      cursor: pointer;
    }

    .remember input {
      accent-color: var(--amber);
      width: 15px;
      height: 15px;
      margin: 0;
    }

    .remember:focus-within { color: var(--text); }

    button {
      font: inherit;
      font-weight: 700;
      line-height: 1.5;
      padding: 2px 16px;
      margin: 4px 0;
      color: var(--ink);
      background: var(--amber);
      border: 0;
      border-radius: 4px;
      cursor: pointer;
    }

    button:hover { background: #ffc76b; }

    button:focus-visible,
    a:focus-visible {
      outline: 2px solid var(--amber);
      outline-offset: 3px;
    }

    a {
      color: var(--sky);
      text-decoration: none;
    }

    a:hover { text-decoration: underline; }

    @media (max-width: 480px) {
      body { font-size: 14px; }
      .ln { grid-template-columns: 36px 1fr; }
      .ln > b { padding-right: 10px; }
      .host { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      .cursor { animation: none; }
    }
  </style>
</head>
<body>
  <main class="editor">
    <div class="tabs">
      <div class="tab">sign_in.md</div>
      <div class="host">{{AppName}}</div>
    </div>

    <form id="signin" class="code" action="{{.SignInLink}}" method="post">
      {{.CsrfTokenHtml}}

      <div class="ln comment"><b>1</b><div><span class="t">// hello, developer.</span></div></div>
      <div class="ln comment"><b>2</b><div><span class="t">// sign in to push, pull and ship.</span></div></div>
      <div class="ln comment"><b>3</b><div><span class="t">// reminder: commit early, never force-push on a Friday.</span><span id="cursor" class="cursor"></span></div></div>
      <div class="ln"><b>4</b><div></div></div>

      {{with .Flash}}{{with .ErrorMsg}}
      <div class="ln err"><b>!</b><div>error: {{.}}</div></div>
      {{end}}{{end}}

      <div class="ln field">
        <b>5</b>
        <div>
          <label class="key" for="user_name">username</label><span class="op">=</span>
          <input id="user_name" type="text" name="user_name" autocomplete="username" autocapitalize="none" spellcheck="false" required>
        </div>
      </div>

      <div class="ln field">
        <b>6</b>
        <div>
          <label class="key" for="password">password</label><span class="op">=</span>
          <input id="password" type="password" name="password" autocomplete="current-password" required>
        </div>
      </div>

      <div class="ln">
        <b>7</b>
        <div>
          <label class="remember"><input type="checkbox" name="remember"> keep me signed in</label>
        </div>
      </div>

      <div class="ln"><b>8</b><div></div></div>

      <div class="ln">
        <b>9</b>
        <div><button type="submit">Sign in</button></div>
      </div>

      <div class="ln">
        <b>10</b>
        <div>
          <a href="{{AppSubUrl}}/user/forgot_password">Forgot password?</a>
          {{if .ShowRegistrationButton}}<a href="{{AppSubUrl}}/user/sign_up">Create an account</a>{{end}}
        </div>
      </div>

      {{range .OAuth2Providers}}
      <div class="ln">
        <b>+</b>
        <div><a href="{{AppSubUrl}}/user/oauth2/{{.DisplayName}}">Sign in with {{.DisplayName}}</a></div>
      </div>
      {{end}}
    </form>
  </main>

  <script>
    (function () {
      var lines = Array.prototype.slice.call(document.querySelectorAll('.t'));
      var cursor = document.getElementById('cursor');
      var form = document.getElementById('signin');
      var user = document.getElementById('user_name');
      var texts = lines.map(function (el) { return el.textContent; });
      var li = 0;
      var ci = 0;
      var timer;

      function done() {
        clearTimeout(timer);
        li = lines.length;
        lines.forEach(function (el, i) { el.textContent = texts[i]; });
        lines[lines.length - 1].after(cursor);
        if (!user.value) { user.focus(); }
      }

      function step() {
        if (li >= lines.length) { return; }
        var el = lines[li];
        el.after(cursor);
        if (ci < texts[li].length) {
          ci += 1;
          el.textContent = texts[li].slice(0, ci);
          timer = setTimeout(step, 22);
        } else {
          li += 1;
          ci = 0;
          if (li >= lines.length) { done(); return; }
          timer = setTimeout(step, 260);
        }
      }

      form.addEventListener('focusin', function () { cursor.classList.add('off'); });
      form.addEventListener('focusout', function () { cursor.classList.remove('off'); });

      window.addEventListener('keydown', function () {
        if (li < lines.length) { done(); }
      });
      window.addEventListener('pointerdown', function () {
        if (li < lines.length) { done(); }
      });

      lines.forEach(function (el) { el.textContent = ''; });
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        done();
      } else {
        step();
      }
    })();
  </script>
</body>
</html>
